# 행정누리 전자민원 설정 예시입니다. 실제 값은 서버 환경변수나 비밀값 저장소에만 두세요.

# 행정누리 내부 시스템 주소 (연동 API /api/epetition/v1/** 앞부분)
NURI_BASE_URL=https://nuri.internal.example:8443
# 서명 비밀값. 행정누리의 APP_EPETITION_SECRET과 같은 값 (영문·숫자·기호 32자 이상, 한글 X, openssl rand -hex 32)
EP_SECRET=
# 행정누리와 http 로 붙는 것을 허용 (내 PC 시험 전용. 운영은 비우거나 false: https 만)
EP_ALLOW_HTTP=
# (선택) 행정누리 내부 인증서가 사설 CA라면 그 CA 파일
NURI_CA_FILE=
# 행정누리 호출 제한 시간 (밀리초)
NURI_TIMEOUT_MS=10000

# 이 서버가 듣는 주소
HOST=0.0.0.0
PORT=8080
# (선택) 직접 HTTPS로 받으려면 인증서와 키. 비우면 앞단 프록시(웹서버·L4)가 TLS를 끝낸다고 봅니다.
TLS_CERT_FILE=
TLS_KEY_FILE=
# 앞단 프록시가 X-Forwarded-For를 붙이면 true (국민 IP를 그 헤더에서 읽음)
TRUST_PROXY=false
# 쿠키 Secure 속성. 운영은 반드시 true. (로컬 http 개발 때만 false)
COOKIE_SECURE=true

# 화면 문구
ORG_NAME=○○시
ORG_CONTACT=민원여권과 02-000-0000
# 개인정보 보유기간 (행정누리 민원 기록 보존기간과 맞춥니다)
PRIVACY_RETENTION=행정누리 민원 기록 보존기간과 같은 기간 (기관 기록관리 기준으로 바꿔 적으세요)
